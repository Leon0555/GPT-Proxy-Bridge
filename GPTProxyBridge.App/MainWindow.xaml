 <local:SmoothBorder x:Name="BasicProfileCard" Style="{StaticResource ProfileCard}"><StackPanel>
  <DockPanel><TextBlock Text="基本配置" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="未保存" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Visibility="{Binding Dirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="配置名称" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="配置名称"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="连接超时（秒，3–120）" Style="{StaticResource Label}"/><TextBox Text="{Binding Timeout,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="连接超时"/></StackPanel>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="协议" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="代理协议"/></StackPanel>
   <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="代理地址" Style="{StaticResource Label}"/><Button x:Name="AddressHelp" Style="{StaticResource InfoHint}" ToolTip="支持本机、局域网、公网地址及域名" AutomationProperties.Name="代理地址说明：支持本机、局域网、公网地址及域名"/></StackPanel><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理地址"/></StackPanel>
   <StackPanel Grid.Column="4"><TextBlock Text="端口" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel>
  </Grid>
 </StackPanel></local:SmoothBorder>
 <local:SmoothBorder x:Name="AuthenticationProfileCard" Style="{StaticResource ProfileCard}"><StackPanel>
  <DockPanel><TextBlock Text="身份认证" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Content="此代理需要账号和密码" IsChecked="{Binding Authentication}" HorizontalAlignment="Right" Margin="0"/></DockPanel>
  <StackPanel Visibility="{Binding Authentication,Converter={StaticResource BoolVisibility}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="账号" Style="{StaticResource Label}"/><Button x:Name="AuthenticationHelp" Style="{StaticResource InfoHint}" ToolTip="HTTP代理认证未加密，请勿在不安全的网络中使用。&#x0a;密码仅为当前 Windows 用户加密保存。" AutomationProperties.Name="HTTP代理认证未加密，请勿在不安全的网络中使用。&#x0a;密码仅为当前 Windows 用户加密保存。"/></StackPanel><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理账号"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="密码" Style="{StaticResource Label}"/><Grid x:Name="PasswordField"><PasswordBox x:Name="SecretBox" PasswordChanged="PasswordChanged" Padding="10,6,40,6" AutomationProperties.Name="代理密码"/><TextBox x:Name="PlainSecret" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}" Padding="10,6,40,6" Visibility="Collapsed" AutomationProperties.Name="可见代理密码"/><ToggleButton x:Name="PasswordReveal" Style="{StaticResource PasswordEye}" Checked="ShowPassword" Unchecked="HidePassword"/></Grid></StackPanel>
   </Grid>
  </StackPanel>
 </StackPanel></local:SmoothBorder>
 <WrapPanel Margin="0,0,0,6"><Button Style="{StaticResource PrimaryAction}" Content="保存配置" Command="{Binding SaveCommand}"/><Button Style="{StaticResource Action}" Content="复制" Command="{Binding DuplicateCommand}"/><Button Style="{StaticResource Action}" Content="{Binding DefaultText}" Command="{Binding DefaultCommand}"/><Button Style="{StaticResource Action}" Content="删除" Command="{Binding DeleteCommand}"/></WrapPanel>
 <StackPanel x:Name="ProfileTestFeedback" Visibility="{Binding HasTestFeedback,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6"><TextBlock Text="{Binding TestSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding HasTestRecord,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding TestStatusText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasTestStatus,Converter={StaticResource BoolVisibility}}"/><ItemsControl ItemsSource="{Binding Results}" Margin="0,3,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" LineHeight="18" Margin="0,0,0,1" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</StackPanel>
<StackPanel Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}">
 <DockPanel Margin="0,0,0,8"><TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="连接设置未保存" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding SettingsDirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
 <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="连接设置" FontSize="15" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地端口（仅 127.0.0.1）" Style="{StaticResource Label}"/><TextBox Text="{Binding LocalPort,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本地监听端口"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="绕过代理的地址（逗号分隔）" Style="{StaticResource Label}"/><TextBox Text="{Binding Bypass,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="绕过列表"/></StackPanel></Grid><TextBlock Text="更改端口或绕过列表后，需退出并重新启动 ChatGPT/Codex。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="应用路径" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="ChatGPT/Codex应用路径（留空自动发现）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding AppPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ChatGPT/Codex应用路径"/><Button Grid.Column="2" Style="{StaticResource Action}" Content="选择…" Click="BrowseApp" Margin="0"/></Grid></StackPanel></Border>
 <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="外观" FontSize="15" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0" AutomationProperties.Name="外观主题"><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Light" ToolTip="亮灯（浅色）" AutomationProperties.Name="亮灯（浅色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Light}" ContentTemplate="{StaticResource LightIcon}" Content="Light"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Dark" ToolTip="熄灯（深色）" AutomationProperties.Name="熄灯（深色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Dark}" ContentTemplate="{StaticResource DarkIcon}" Content="Dark"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="System" ToolTip="跟随系统" AutomationProperties.Name="跟随系统" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=System}" ContentTemplate="{StaticResource SystemIcon}" Content="System"/></StackPanel><TextBlock Text="外观即时保存。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="软件更新" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CheckUpdatesButton" Grid.Column="2" Content="检查更新" Style="{StaticResource Action}" Command="{Binding CheckUpdatesCommand}" Margin="0"/><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentVersionText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid></Border>
 <WrapPanel><Button Content="保存设置" Style="{StaticResource PrimaryAction}" Command="{Binding SaveSettingsCommand}"/><Button Content="导出配置（不含密码）" Style="{StaticResource LongAction}" Command="{Binding ExportCommand}"/></WrapPanel>
</StackPanel>
</StackPanel></ScrollViewer>
</DockPanel></local:SmoothBorder></Grid></Window>

