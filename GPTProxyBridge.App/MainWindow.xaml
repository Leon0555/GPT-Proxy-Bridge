<Window x:Class="GPTProxyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GPTProxyBridge.App" Foreground="{DynamicResource TextBrush}" Icon="Assets/app.ico" Title="GPT Proxy Bridge" Width="1060" Height="800" MinWidth="1000" MinHeight="780" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
<Window.Resources>
<local:ThemeModeConverter x:Key="ThemeMode"/>
<Style x:Key="ThemeIcon" TargetType="RadioButton">
 <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
  <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<DataTemplate x:Key="LightIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z M9,20 L15,20 M10.5,23 L13.5,23 M12,0 L12,2 M2,4 L4,6 M20,6 L22,4 M1,11 L3,11 M21,11 L23,11"/><Path Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.2" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z"/></Canvas></Viewbox></DataTemplate>
<DataTemplate x:Key="DarkIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z M9,20 L15,20 M10.5,23 L13.5,23"/></Canvas></Viewbox></DataTemplate>
<DataTemplate x:Key="SystemIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent" Data="M3,4 L21,4 L21,17 L3,17 Z M12,17 L12,21 M8,21 L16,21 M3,13 L21,13"/></Canvas></Viewbox></DataTemplate>
<Style x:Key="PasswordEye" TargetType="ToggleButton">
 <Setter Property="Width" Value="34"/><Setter Property="Margin" Value="0,1,1,1"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="ToolTip" Value="显示密码"/><Setter Property="AutomationProperties.Name" Value="显示密码"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" Data="M2,12 C6,4 18,4 22,12 C18,20 6,20 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12"/><Path x:Name="Slash" Visibility="Collapsed" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L21,21"/></Canvas></Viewbox></Border><ControlTemplate.Triggers>
  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarBrush}"/></Trigger>
  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="隐藏密码"/><Setter Property="AutomationProperties.Name" Value="隐藏密码"/></Trigger></Style.Triggers>
</Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,4"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style><local:ThemeLabel x:Key="ThemeLabel"/><local:ProfileStateLabel x:Key="ProfileStateLabel"/></Window.Resources><Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/></Window.InputBindings>
<Grid Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="18,24,18,18">
<StackPanel DockPanel.Dock="Top" Margin="8,0,8,24"><TextBlock Text="GPT Proxy Bridge" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="让每次连接，都有清晰去向。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding Available}"><Button Content="新增配置" Command="{Binding AddCommand}" Margin="0,8,0,8"/><Button Content="导入旧脚本配置" Command="{Binding ImportCommand}" Margin="0,0,0,8"/><Button x:Name="SettingsNavigation" Content="设置" Command="{Binding SettingsCommand}" Margin="0,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SettingsVisible}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.Name="外观主题"><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="Light" ToolTip="亮灯（浅色）" AutomationProperties.Name="亮灯（浅色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Light}" ContentTemplate="{StaticResource LightIcon}" Content="Light"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="Dark" ToolTip="熄灯（深色）" AutomationProperties.Name="熄灯（深色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Dark}" ContentTemplate="{StaticResource DarkIcon}" Content="Dark"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="System" ToolTip="跟随系统" AutomationProperties.Name="跟随系统" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=System}" ContentTemplate="{StaticResource SystemIcon}" Content="System"/></StackPanel><TextBlock Text="仅为ChatGPT/Codex桌面端提供代理配置" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="4,14,0,0"/></StackPanel>
<ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" IsEnabled="{Binding Available}" AutomationProperties.Name="代理配置列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource SidebarBrush}" BorderThickness="0"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProfileClicked"/><EventSetter Event="PreviewKeyDown" Handler="ProfileKeyDown"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.EditorVisible,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></MultiDataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}"><TextBlock.Text><MultiBinding Converter="{StaticResource ProfileStateLabel}"><Binding Path="Id"/><Binding Path="DataContext.ActiveProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.DefaultProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</DockPanel></Border>
<DockPanel Grid.Column="1">
<Border x:Name="RuntimeBar" DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
<StackPanel><DockPanel><TextBlock Text="运行状态" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="正在处理…" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<TextBlock x:Name="RuntimeLabel" Text="{Binding RuntimeText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsBridgeRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActiveText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding AppText}" FontSize="12" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}"/></Grid></StackPanel></Border>
<Border x:Name="ConnectionBar" DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
<StackPanel><DockPanel Margin="0,0,0,7"><TextBlock Text="连接控制" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionHint}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
<WrapPanel IsEnabled="{Binding Available}"><Button Padding="9,8" FontSize="12" Content="测试连接" Command="{Binding TestCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="应用配置" Command="{Binding ApplyCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="连接并启动 ChatGPT/Codex" Style="{StaticResource Primary}" Command="{Binding LaunchCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="打开 ChatGPT/Codex" Command="{Binding OpenAppCommand}"/><Button Padding="9,8" FontSize="12" Content="停止代理" Command="{Binding StopCommand}"/></WrapPanel>
</StackPanel></Border>
<ScrollViewer x:Name="EditorScroll" FocusVisualStyle="{x:Null}" Margin="24,16,24,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<StackPanel Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}">
<DockPanel Margin="0,0,0,10"><TextBlock Text="配置详情" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ProfileStateLabel" Text="{Binding ProfileStateText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingApply}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="基本配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="未保存" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Visibility="{Binding Dirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置名称" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="配置名称"/></StackPanel><StackPanel Grid.Column="2"><StackPanel><TextBlock Text="连接超时（秒，3–120）" Style="{StaticResource Label}"/><TextBox Text="{Binding Timeout,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="连接超时"/></StackPanel></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="协议" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="代理协议"/></StackPanel><StackPanel Grid.Column="2"><StackPanel><TextBlock Text="代理地址" Style="{StaticResource Label}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理地址"/></StackPanel></StackPanel><StackPanel Grid.Column="4"><StackPanel><TextBlock Text="端口" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel></StackPanel></Grid><TextBlock Text="支持本机、局域网、公网地址及域名" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="身份认证" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Content="此代理需要账号和密码" IsChecked="{Binding Authentication}" HorizontalAlignment="Right" Margin="0"/></DockPanel><StackPanel Visibility="{Binding Authentication,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="账号" Style="{StaticResource Label}"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理账号"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码" Style="{StaticResource Label}"/><Grid x:Name="PasswordField"><PasswordBox x:Name="SecretBox" PasswordChanged="PasswordChanged" Padding="10,8,40,8" AutomationProperties.Name="代理密码"/><TextBox x:Name="PlainSecret" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}" Padding="10,8,40,8" Visibility="Collapsed" AutomationProperties.Name="可见代理密码"/><ToggleButton x:Name="PasswordReveal" Style="{StaticResource PasswordEye}" Checked="ShowPassword" Unchecked="HidePassword"/></Grid></StackPanel></Grid><TextBlock Text="密码仅为当前 Windows 用户加密保存。HTTP 代理认证本身不提供传输加密。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></StackPanel></Border><WrapPanel Margin="0,0,0,6"><Button Content="保存配置" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/><Button Content="复制" Command="{Binding DuplicateCommand}"/><Button Content="{Binding DefaultText}" Command="{Binding DefaultCommand}"/><Button Content="删除" Command="{Binding DeleteCommand}"/></WrapPanel><StackPanel x:Name="ProfileTestFeedback" Visibility="{Binding HasTestFeedback,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6"><TextBlock Text="{Binding TestSummaryText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding HasTestRecord,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding TestStatusText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasTestStatus,Converter={StaticResource BoolVisibility}}"/><ItemsControl ItemsSource="{Binding Results}" Margin="0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,1,0,1" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</StackPanel>
<StackPanel Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="连接设置未保存" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding SettingsDirty,Converter={StaticResource BoolVisibility}}"/></DockPanel><TextBlock Text="外观即时保存；连接设置修改后请点击“保存设置”。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,6"/><TextBlock Text="本地监听端口（仅 127.0.0.1）" Style="{StaticResource Label}"/><TextBox Text="{Binding LocalPort,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本地监听端口"/><TextBlock Text="绕过代理的地址（逗号分隔）" Style="{StaticResource Label}"/><TextBox Text="{Binding Bypass,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="绕过列表"/><TextBlock Text="ChatGPT/Codex应用路径（留空自动发现）" Style="{StaticResource Label}"/><TextBox Text="{Binding AppPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ChatGPT/Codex应用路径"/><Button Content="选择 ChatGPT/Codex…" Click="BrowseApp" HorizontalAlignment="Left" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.Name="外观主题"><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Light" ToolTip="亮灯（浅色）" AutomationProperties.Name="亮灯（浅色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Light}" ContentTemplate="{StaticResource LightIcon}" Content="Light"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Dark" ToolTip="熄灯（深色）" AutomationProperties.Name="熄灯（深色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Dark}" ContentTemplate="{StaticResource DarkIcon}" Content="Dark"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="System" ToolTip="跟随系统" AutomationProperties.Name="跟随系统" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=System}" ContentTemplate="{StaticResource SystemIcon}" Content="System"/></StackPanel><TextBlock Text="更改端口或绕过列表后，需要退出并重新启动ChatGPT/Codex应用。关闭本窗口会继续在托盘运行。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,16"/><WrapPanel><Button Content="保存设置" Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}"/><Button Content="导出配置（不含密码）" Command="{Binding ExportCommand}"/></WrapPanel></StackPanel></Border></StackPanel>

</StackPanel></ScrollViewer>
</DockPanel></Grid></Window>

