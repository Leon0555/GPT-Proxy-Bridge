<Window x:Class="GPTProxyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GPTProxyBridge.App" Foreground="{DynamicResource TextBrush}" Icon="Assets/app.ico" Title="GPT Proxy Bridge" Width="1060" Height="800" MinWidth="1000" MinHeight="780" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
<Window.Resources><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/></Style><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,6,0,4"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style><local:ThemeLabel x:Key="ThemeLabel"/><local:ProfileStateLabel x:Key="ProfileStateLabel"/></Window.Resources><Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/></Window.InputBindings>
<Grid Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="18,24,18,18">
<StackPanel DockPanel.Dock="Top" Margin="8,0,8,24"><TextBlock Text="GPT Proxy Bridge" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="让每次连接，都有清晰去向。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding Available}"><Button Content="新增配置" Command="{Binding AddCommand}" Margin="0,8,0,8"/><Button Content="导入旧脚本配置" Command="{Binding ImportCommand}" Margin="0,0,0,8"/><Button Content="设置" Command="{Binding SettingsCommand}" Margin="0,0,0,0"/><TextBlock Text="外观" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme,Mode=TwoWay}" AutomationProperties.Name="侧栏外观主题"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ThemeLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="仅为ChatGPT/Codex桌面端提供代理配置" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="4,14,0,0"/></StackPanel>
<ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" IsEnabled="{Binding Available}" AutomationProperties.Name="代理配置列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource SidebarBrush}" BorderThickness="0"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProfileClicked"/><EventSetter Event="PreviewKeyDown" Handler="ProfileKeyDown"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}"><TextBlock.Text><MultiBinding Converter="{StaticResource ProfileStateLabel}"><Binding Path="Id"/><Binding Path="DataContext.ActiveProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.DefaultProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</DockPanel></Border>
<DockPanel Grid.Column="1">
<Border x:Name="RuntimeBar" DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
<StackPanel><DockPanel><TextBlock Text="运行状态" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="正在处理…" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<TextBlock Text="{Binding RuntimeText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,6"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActiveText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding AppText}" FontSize="12" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}"/></Grid></StackPanel></Border>
<Border x:Name="ConnectionBar" DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
<StackPanel><DockPanel Margin="0,0,0,7"><TextBlock Text="连接控制" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="保存配置后，在此连接并启动 ChatGPT/Codex" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
<WrapPanel IsEnabled="{Binding Available}"><Button Padding="9,8" FontSize="12" Content="测试连接" Command="{Binding TestCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="应用配置" Command="{Binding ApplyCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="连接并启动 ChatGPT/Codex" Style="{StaticResource Primary}" Command="{Binding LaunchCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><Button Padding="9,8" FontSize="12" Content="打开 ChatGPT/Codex" Command="{Binding OpenAppCommand}"/><Button Padding="9,8" FontSize="12" Content="停止代理" Command="{Binding StopCommand}"/></WrapPanel>
</StackPanel></Border>
<ScrollViewer x:Name="EditorScroll" Margin="24,16,24,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<StackPanel Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}">
<TextBlock Text="配置详情" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="基本配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="未保存" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Visibility="{Binding Dirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置名称" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="配置名称"/></StackPanel><StackPanel Grid.Column="2"><StackPanel><TextBlock Text="连接超时（秒，3–120）" Style="{StaticResource Label}"/><TextBox Text="{Binding Timeout,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="连接超时"/></StackPanel></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="协议" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="代理协议"/></StackPanel><StackPanel Grid.Column="2"><StackPanel><TextBlock Text="代理地址" Style="{StaticResource Label}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理地址"/></StackPanel></StackPanel><StackPanel Grid.Column="4"><StackPanel><TextBlock Text="端口" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel></StackPanel></Grid><TextBlock Text="支持本机、局域网、公网地址及域名" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="身份认证" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Content="此代理需要账号和密码" IsChecked="{Binding Authentication}" HorizontalAlignment="Right" Margin="0"/></DockPanel><StackPanel Visibility="{Binding Authentication,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="账号" Style="{StaticResource Label}"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理账号"/></StackPanel><StackPanel Grid.Column="2"><DockPanel><TextBlock Text="密码" Style="{StaticResource Label}"/><CheckBox Content="显示密码" Checked="ShowPassword" Unchecked="HidePassword" HorizontalAlignment="Right" Margin="0" FontSize="12"/></DockPanel><PasswordBox x:Name="SecretBox" PasswordChanged="PasswordChanged" AutomationProperties.Name="代理密码"/><TextBox x:Name="PlainSecret" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" AutomationProperties.Name="可见代理密码"/></StackPanel></Grid><TextBlock Text="密码仅为当前 Windows 用户加密保存。HTTP 代理认证本身不提供传输加密。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></StackPanel></Border><WrapPanel Margin="0,0,0,8"><Button Content="保存配置" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/><Button Content="复制" Command="{Binding DuplicateCommand}"/><Button Content="{Binding DefaultText}" Command="{Binding DefaultCommand}"/><Button Content="删除" Command="{Binding DeleteCommand}"/></WrapPanel>
</StackPanel>
<StackPanel Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="本地监听端口（仅 127.0.0.1）" Style="{StaticResource Label}"/><TextBox Text="{Binding LocalPort,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本地监听端口"/><TextBlock Text="绕过代理的地址（逗号分隔）" Style="{StaticResource Label}"/><TextBox Text="{Binding Bypass,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="绕过列表"/><TextBlock Text="ChatGPT/Codex应用路径（留空自动发现）" Style="{StaticResource Label}"/><TextBox Text="{Binding AppPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ChatGPT/Codex应用路径"/><Button Content="选择 ChatGPT/Codex…" Click="BrowseApp" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="外观" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="外观主题"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ThemeLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="更改端口或绕过列表后，需要退出并重新启动ChatGPT/Codex应用。关闭本窗口会继续在托盘运行。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,16"/><WrapPanel><Button Content="保存设置" Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}"/><Button Content="导出配置（不含密码）" Command="{Binding ExportCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
<ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,10"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,1,0,1" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer>
</DockPanel></Grid></Window>

