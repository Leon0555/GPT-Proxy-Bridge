<Window x:Class="GPTProxyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GPTProxyBridge.App" Foreground="{DynamicResource TextBrush}" Icon="Assets/app.ico" Title="GPT Proxy Bridge" Width="1060" Height="800" MinWidth="1000" MinHeight="780" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Window.Resources>
<local:ThemeModeConverter x:Key="ThemeMode"/><local:SidebarBottomMargin x:Key="SidebarBottomMargin"/>
<Style x:Key="ThemeIcon" TargetType="RadioButton">
 <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
  <Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="FocusMark" Margin="3" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<DataTemplate x:Key="LightIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z M9,20 L15,20 M10.5,23 L13.5,23 M12,0 L12,2 M2,4 L4,6 M20,6 L22,4 M1,11 L3,11 M21,11 L23,11"/><Path Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Opacity="0.2" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z"/></Canvas></Viewbox></DataTemplate>
<DataTemplate x:Key="DarkIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M9,17 C9,14 6.5,13.8 6.5,10 A5.5,5.5 0 1 1 17.5,10 C17.5,13.8 15,14 15,17 Z M9,20 L15,20 M10.5,23 L13.5,23"/></Canvas></Viewbox></DataTemplate>
<DataTemplate x:Key="SystemIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent" Data="M3,4 L21,4 L21,17 L3,17 Z M12,17 L12,21 M8,21 L16,21 M3,13 L21,13"/></Canvas></Viewbox></DataTemplate>
<Style x:Key="PasswordEye" TargetType="ToggleButton">
 <Setter Property="Width" Value="34"/><Setter Property="Margin" Value="0,1,1,1"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="ToolTip" Value="显示密码"/><Setter Property="AutomationProperties.Name" Value="显示密码"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" Data="M2,12 C6,4 18,4 22,12 C18,20 6,20 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12"/><Path x:Name="Slash" Visibility="Collapsed" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L21,21"/></Canvas></Viewbox></Border><ControlTemplate.Triggers>
  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarBrush}"/></Trigger>
  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="隐藏密码"/><Setter Property="AutomationProperties.Name" Value="隐藏密码"/></Trigger></Style.Triggers>
</Style>

<Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style x:Key="LongAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style x:Key="PrimaryLongAction" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style x:Key="InfoHint" TargetType="Button">
 <Setter Property="Width" Value="20"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/><Setter Property="ToolTipService.ShowDuration" Value="30000"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"/><Grid Width="11" Height="11"><Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/><TextBlock Text="!" FontSize="9" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="9"/></Grid></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,0,0,10"/><Setter Property="Margin" Value="0,0,0,8"/></Style><Style x:Key="ProfileCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="11"/><Setter Property="Margin" Value="0,0,0,8"/></Style><Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,4"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style><local:ThemeLabel x:Key="ThemeLabel"/><local:ProfileStateLabel x:Key="ProfileStateLabel"/></Window.Resources><Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/></Window.InputBindings>
<Grid Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="18,24,18,18">
<StackPanel DockPanel.Dock="Top" Margin="8,0,8,24"><TextBlock x:Name="BrandTitle" Text="GPT Proxy Bridge" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="让每次连接，都有清晰去向。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding Available}"><StackPanel.Margin><MultiBinding Converter="{StaticResource SidebarBottomMargin}"><Binding ElementName="ConnectionBar" Path="ActualHeight"/><Binding ElementName="AppearanceButtons" Path="ActualHeight"/><Binding ElementName="SidebarFooter" Path="ActualHeight"/></MultiBinding></StackPanel.Margin><Button Content="新增配置" Command="{Binding AddCommand}" Margin="0,8,0,8"/><Button Content="导入旧脚本配置" Command="{Binding ImportCommand}" Margin="0,0,0,8"/><Button x:Name="SettingsNavigation" Content="设置" Command="{Binding SettingsCommand}" Margin="0,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SettingsVisible}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel x:Name="AppearanceButtons" Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.Name="外观主题"><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="Light" ToolTip="亮灯（浅色）" AutomationProperties.Name="亮灯（浅色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Light}" ContentTemplate="{StaticResource LightIcon}" Content="Light"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="Dark" ToolTip="熄灯（深色）" AutomationProperties.Name="熄灯（深色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Dark}" ContentTemplate="{StaticResource DarkIcon}" Content="Dark"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SidebarAppearance" Tag="System" ToolTip="跟随系统" AutomationProperties.Name="跟随系统" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=System}" ContentTemplate="{StaticResource SystemIcon}" Content="System"/></StackPanel><TextBlock x:Name="SidebarFooter" Text="仅为ChatGPT/Codex桌面端提供代理配置" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="4,14,0,0"/></StackPanel>
<ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" IsEnabled="{Binding Available}" AutomationProperties.Name="代理配置列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource SidebarBrush}" BorderThickness="0"><Grid><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer><TextBlock Text="暂无配置" Margin="12,8,0,0" VerticalAlignment="Top" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></ControlTemplate></ListBox.Template><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProfileClicked"/><EventSetter Event="PreviewKeyDown" Handler="ProfileKeyDown"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.EditorVisible,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></MultiDataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}"><TextBlock.Text><MultiBinding Converter="{StaticResource ProfileStateLabel}"><Binding Path="Id"/><Binding Path="DataContext.ActiveProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.DefaultProfileId" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</DockPanel></Border>
<DockPanel Grid.Column="1">

<Border x:Name="RuntimeBar" DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,28,24,12">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,12,0"><TextBlock x:Name="BridgeSectionTitle" Text="本地桥接" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock x:Name="RuntimeLabel" Text="{Binding RuntimeText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,3"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsBridgeRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock x:Name="ActiveProfileInfo" Text="{Binding ActiveText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
  <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0"><StackPanel><DockPanel><TextBlock x:Name="AppSectionTitle" Text="ChatGPT/Codex" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="正在处理…" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel><TextBlock x:Name="AppRuntimeLabel" Text="{Binding AppText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,3" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAppRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="AppSourceInfo" Text="{Binding AppSourceText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
 </Grid>
</Border>
<Border x:Name="ConnectionBar" MinHeight="100" DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
 <StackPanel><DockPanel Margin="0,0,0,4"><TextBlock x:Name="ConnectionTitle" Text="连接控制" DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionHint}" DockPanel.Dock="Right" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/><TextBlock x:Name="SettingsConnectionMessage" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></DockPanel>
  <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}"/>
  <WrapPanel IsEnabled="{Binding Available}">
   <Button Style="{StaticResource Action}" Content="测试连接" Command="{Binding TestCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" ToolTip="测试当前配置，不切换代理"/>
   <Button Style="{StaticResource Action}" Content="应用配置" Command="{Binding ApplyCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" ToolTip="测试并应用已保存的配置"/>
   <Button Style="{StaticResource PrimaryLongAction}" Content="连接并启动 ChatGPT/Codex" Command="{Binding LaunchCommand}" Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" ToolTip="应用代理配置并启动 ChatGPT/Codex"/>
   <Button Style="{StaticResource LongAction}" Content="打开 ChatGPT/Codex" Command="{Binding OpenAppCommand}" ToolTip="打开 ChatGPT/Codex，使用现有桥接和应用状态"/>
   <Button Style="{StaticResource Action}" Content="停止代理" Command="{Binding StopCommand}"/>
  </WrapPanel>
 </StackPanel>
</Border>
<ScrollViewer x:Name="EditorScroll" FocusVisualStyle="{x:Null}" Margin="24,14,24,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<StackPanel Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}">
 <DockPanel Margin="0,0,0,8"><TextBlock Text="配置详情" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ProfileStateLabel" Text="{Binding ProfileStateText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingApply}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
 <Border x:Name="BasicProfileCard" Style="{StaticResource ProfileCard}"><StackPanel>
  <DockPanel><TextBlock Text="基本配置" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="未保存" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Visibility="{Binding Dirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="配置名称" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="配置名称"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="连接超时（秒，3–120）" Style="{StaticResource Label}"/><TextBox Text="{Binding Timeout,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="连接超时"/></StackPanel>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="协议" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="代理协议"/></StackPanel>
   <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="代理地址" Style="{StaticResource Label}"/><Button x:Name="AddressHelp" Style="{StaticResource InfoHint}" ToolTip="支持本机、局域网、公网地址及域名" AutomationProperties.Name="代理地址说明：支持本机、局域网、公网地址及域名"/></StackPanel><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理地址"/></StackPanel>
   <StackPanel Grid.Column="4"><TextBlock Text="端口" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel>
  </Grid>
 </StackPanel></Border>
 <Border x:Name="AuthenticationProfileCard" Style="{StaticResource ProfileCard}"><StackPanel>
  <DockPanel><TextBlock Text="身份认证" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Content="此代理需要账号和密码" IsChecked="{Binding Authentication}" HorizontalAlignment="Right" Margin="0"/></DockPanel>
  <StackPanel Visibility="{Binding Authentication,Converter={StaticResource BoolVisibility}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="账号" Style="{StaticResource Label}"/><Button x:Name="AuthenticationHelp" Style="{StaticResource InfoHint}" ToolTip="HTTP代理认证未加密，请勿在不安全的网络中使用。&#x0a;密码仅为当前 Windows 用户加密保存。" AutomationProperties.Name="HTTP代理认证未加密，请勿在不安全的网络中使用。&#x0a;密码仅为当前 Windows 用户加密保存。"/></StackPanel><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理账号"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="密码" Style="{StaticResource Label}"/><Grid x:Name="PasswordField"><PasswordBox x:Name="SecretBox" PasswordChanged="PasswordChanged" Padding="10,6,40,6" AutomationProperties.Name="代理密码"/><TextBox x:Name="PlainSecret" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}" Padding="10,6,40,6" Visibility="Collapsed" AutomationProperties.Name="可见代理密码"/><ToggleButton x:Name="PasswordReveal" Style="{StaticResource PasswordEye}" Checked="ShowPassword" Unchecked="HidePassword"/></Grid></StackPanel>
   </Grid>
  </StackPanel>
 </StackPanel></Border>
 <WrapPanel Margin="0,0,0,6"><Button Style="{StaticResource PrimaryAction}" Content="保存配置" Command="{Binding SaveCommand}"/><Button Style="{StaticResource Action}" Content="复制" Command="{Binding DuplicateCommand}"/><Button Style="{StaticResource Action}" Content="{Binding DefaultText}" Command="{Binding DefaultCommand}"/><Button Style="{StaticResource Action}" Content="删除" Command="{Binding DeleteCommand}"/></WrapPanel>
 <StackPanel x:Name="ProfileTestFeedback" Visibility="{Binding HasTestFeedback,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6"><TextBlock Text="{Binding TestSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding HasTestRecord,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding TestStatusText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasTestStatus,Converter={StaticResource BoolVisibility}}"/><ItemsControl ItemsSource="{Binding Results}" Margin="0,3,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,1,0,1" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
</StackPanel>
<StackPanel Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Available}">
 <DockPanel Margin="0,0,0,8"><TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="连接设置未保存" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding SettingsDirty,Converter={StaticResource BoolVisibility}}"/></DockPanel>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接设置" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="本地监听端口（仅 127.0.0.1）" Style="{StaticResource Label}"/><TextBox Text="{Binding LocalPort,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="本地监听端口"/><TextBlock Text="绕过代理的地址（逗号分隔）" Style="{StaticResource Label}"/><TextBox Text="{Binding Bypass,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="绕过列表"/><TextBlock Text="更改端口或绕过列表后，需退出并重新启动 ChatGPT/Codex。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="应用路径" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="ChatGPT/Codex应用路径（留空自动发现）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding AppPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ChatGPT/Codex应用路径"/><Button Grid.Column="2" Style="{StaticResource Action}" Content="选择…" Click="BrowseApp" Margin="0"/></Grid></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="外观" FontSize="15" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0" AutomationProperties.Name="外观主题"><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Light" ToolTip="亮灯（浅色）" AutomationProperties.Name="亮灯（浅色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Light}" ContentTemplate="{StaticResource LightIcon}" Content="Light"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="Dark" ToolTip="熄灯（深色）" AutomationProperties.Name="熄灯（深色）" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=Dark}" ContentTemplate="{StaticResource DarkIcon}" Content="Dark"/><RadioButton Style="{StaticResource ThemeIcon}" GroupName="SettingsAppearance" Tag="System" ToolTip="跟随系统" AutomationProperties.Name="跟随系统" IsChecked="{Binding Theme,Mode=TwoWay,Converter={StaticResource ThemeMode},ConverterParameter=System}" ContentTemplate="{StaticResource SystemIcon}" Content="System"/></StackPanel><TextBlock Text="外观即时保存。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
 <WrapPanel><Button Content="保存设置" Style="{StaticResource PrimaryAction}" Command="{Binding SaveSettingsCommand}"/><Button Content="导出配置（不含密码）" Style="{StaticResource LongAction}" Command="{Binding ExportCommand}"/></WrapPanel>
</StackPanel>
</StackPanel></ScrollViewer>
</DockPanel></Grid></Window>

